<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Gem300.Desktop.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="5"/></Style>
    <Style Selector="DataGrid"><Setter Property="RowHeight" Value="29"/><Setter Property="FontSize" Value="12"/></Style>
  </Application.Styles>
</Application>
